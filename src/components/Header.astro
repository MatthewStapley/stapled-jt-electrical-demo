---
import { asset, brand, nav } from "../data/site";
const home = asset("/");
---
<header class="head">
  <a href={home} class="brand" aria-label={`${brand.name}, home`}>
    <img src={asset(brand.logo)} alt="" width="60" height="60" />
    <span class="brand__name"><b>JT</b> <span>Electrical</span></span>
  </a>
  <nav aria-label="Main" class="head__nav">
    {nav.map((n) => <a href={`${home}#${n.id}`} data-spy={n.id}>{n.label}</a>)}
  </nav>
  <div class="head__actions">
    <a href={`${home}#enquire`} class="btn head__cta"><span>Enquire</span></a>
    <button type="button" class="head__menu" data-menu-open aria-haspopup="dialog">
      <span class="head__bars" aria-hidden="true"><i></i><i></i></span>
      <span class="sr">Menu</span>
    </button>
  </div>
</header>

<dialog class="menu" data-menu aria-label="Menu">
  <div class="menu__top">
    <img src={asset(brand.logo)} alt="" width="56" height="56" />
    <button type="button" class="menu__close" data-menu-close>Close</button>
  </div>
  <nav aria-label="Menu links">
    <ul>
      {nav.map((n) => <li><a href={`${home}#${n.id}`} data-menu-link>{n.label}</a></li>)}
      <li><a href={`${home}#enquire`} data-menu-link>Enquire</a></li>
    </ul>
  </nav>
  <a class="btn menu__dm" href={brand.instagram} target="_blank" rel="noopener">
    <span>Message on Instagram</span>
  </a>
</dialog>

<style>
  .head {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    height: var(--header-h);
    padding-inline: var(--gutter);
    background: var(--char);
    color: var(--on-char);
    box-shadow: 0 1px 0 var(--rule-char);
  }
  .brand { justify-self: start; display: inline-flex; align-items: center; gap: 0.85rem; min-height: 2.75rem; text-decoration: none; }
  .brand img, .menu__top img { border-radius: 50%; flex: none; }
  .brand__name {
    font-family: var(--display); font-style: italic; font-weight: 800;
    font-variation-settings: "wdth" 125; text-transform: uppercase;
    font-size: 1.55rem; line-height: 1; white-space: nowrap;
  }
  .brand__name b { font-weight: 800; color: var(--volt); }

  .head__nav { display: flex; gap: 0.5rem; }
  .head__nav a {
    position: relative; display: inline-flex; align-items: center; min-height: 2.75rem; padding-inline: 0.85rem;
    font-family: var(--display); font-style: italic; font-weight: 650; font-variation-settings: "wdth" 104;
    font-size: 1.0625rem; text-decoration: none;
  }
  .head__nav a::after {
    content: ""; position: absolute; left: 0.85rem; right: 0.85rem; bottom: 0.2rem; height: 0.3rem;
    background: var(--volt); transform: skewX(var(--slant)) scaleX(0); transform-origin: left; transition: transform 420ms var(--ease);
  }
  .head__nav a[aria-current="true"]::after { transform: skewX(var(--slant)) scaleX(1); }
  @media (hover: hover) { .head__nav a:hover::after { transform: skewX(var(--slant)) scaleX(1); } }

  .head__actions { justify-self: end; display: flex; align-items: center; gap: 0.4rem; }
  .head__cta { min-height: 3rem; --over: 0.55rem; padding-inline: 1.7rem; }
  .head__menu { display: none; place-items: center; width: 2.75rem; height: 2.75rem; margin-right: -0.5rem; border: 0; background: none; cursor: pointer; }
  .head__bars { display: grid; gap: 7px; width: 1.5rem; }
  .head__bars i { height: 3px; background: currentColor; transform: skewX(var(--slant)); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  .menu {
    width: 100%; max-width: none; height: 100dvh; max-height: none; margin: 0; border: 0;
    padding: 1rem var(--gutter) max(1.5rem, env(safe-area-inset-bottom));
    background: var(--char); color: var(--on-char);
  }
  .menu[open] { display: flex; flex-direction: column; animation: menu-in 420ms var(--ease) both; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-0.75rem); } }
  .menu__top { display: flex; align-items: center; justify-content: space-between; }
  .menu__close { min-height: 2.75rem; padding-inline: 0.5rem; margin-right: -0.5rem; border: 0; background: none; font-weight: 620; text-decoration: underline; text-underline-offset: 0.25em; cursor: pointer; }
  .menu nav { flex: 1; display: flex; align-items: center; }
  .menu ul { width: 100%; }
  .menu li { border-top: 1px solid var(--rule-char); }
  .menu li:last-child { border-bottom: 1px solid var(--rule-char); }
  .menu li a { display: block; padding-block: 0.9rem; font-family: var(--display); font-style: italic; font-weight: 800; font-variation-settings: "wdth" 120; text-transform: uppercase; font-size: 2rem; line-height: 1.1; text-decoration: none; }
  .menu__dm { width: 100%; }

  @media (max-width: 960px) {
    .head { grid-template-columns: 1fr auto; }
    .head__nav { display: none; }
    .head__menu { display: grid; }
  }
  @media (max-width: 560px) {
    .brand { gap: 0.6rem; }
    .brand img { width: 50px; height: 50px; }
    .brand__name { display: grid; font-size: 1.5rem; line-height: 0.95; }
    .brand__name span { font-size: 0.8rem; font-variation-settings: "wdth" 118; letter-spacing: 0.02em; }
    .head__cta { min-height: 2.75rem; padding-inline: 1.45rem; }
  }
  @media (max-width: 359px) {
    .brand { gap: 0.4rem; }
    .brand img { width: 42px; height: 42px; }
    .head { gap: 0.4rem; }
    .head__cta { padding-inline: 1.05rem; }
  }
</style>
