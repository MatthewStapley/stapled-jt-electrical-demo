---
import { services } from "../data/services";
import { brand } from "../data/site";
const ig = '<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><path d="M16.9 7.1h.01"/>';
---
<section class="band" data-tone="dark" id="enquire" aria-labelledby="enquire-title">
  <span class="node" data-line-node="left" aria-hidden="true"></span>
  <div class="wrap enq">
    <div class="enq__lead">
      <h2 id="enquire-title" class="enq__title" data-r>Got electrical work that needs doing?</h2>
      <p class="lede soft" data-r>Send a direct message with what you need and where you are, and get your dates booked in.</p>
      <div class="enq__dm" data-r>
        <a class="btn" href={brand.instagram} target="_blank" rel="noopener" data-line-end>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ig}></svg>
          <span>Message on Instagram</span>
        </a>
        <p class="small soft">{brand.handle}</p>
      </div>
    </div>

    <div class="form" data-r>
      <p class="form__flag"><strong>Preview only.</strong> This form shows how enquiries could work. Nothing you enter is sent or saved, so please use Instagram to reach JT Electrical.</p>

      <form method="dialog" novalidate data-enquiry>
        <div class="f">
          <label for="e-name">Your name</label>
          <input id="e-name" name="name" type="text" autocomplete="name" required aria-describedby="e-name-err" />
          <p class="f__err" id="e-name-err" hidden></p>
        </div>
        <div class="f">
          <label for="e-contact">Phone or email</label>
          <input id="e-contact" name="contact" type="text" autocomplete="off" inputmode="text" required aria-describedby="e-contact-err" />
          <p class="f__err" id="e-contact-err" hidden></p>
        </div>
        <div class="f">
          <label for="e-service">What do you need?</label>
          <div class="f__select">
            <select id="e-service" name="service" required aria-describedby="e-service-err">
              <option value="">Choose one</option>
              {services.map((s) => <option value={s.name}>{s.name}</option>)}
              <option value="Something else">Something else</option>
            </select>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </div>
          <p class="f__err" id="e-service-err" hidden></p>
        </div>
        <div class="f">
          <label for="e-area">Your town or area</label>
          <input id="e-area" name="area" type="text" autocomplete="off" required aria-describedby="e-area-err" />
          <p class="f__err" id="e-area-err" hidden></p>
        </div>
        <div class="f f--full">
          <label for="e-msg">Anything else? <span>Optional</span></label>
          <textarea id="e-msg" name="message" rows="3"></textarea>
        </div>
        <button class="btn btn--panel form__go" type="submit">
          <span>Try the preview</span>
          <svg class="btn__go" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
        </button>
      </form>

      <div class="done" data-enquiry-done hidden tabindex="-1">
        <h3 class="sub">That's how it would feel.</h3>
        <p><strong>Your details were not sent or saved.</strong> On the finished site, this is where an enquiry would be delivered to JT Electrical and confirmed.</p>
        <a class="btn btn--panel" href={brand.instagram} target="_blank" rel="noopener"><span>Message on Instagram instead</span></a>
        <button class="link done__reset" type="button" data-enquiry-reset>Clear and try again</button>
      </div>
    </div>
  </div>
</section>

<style>
  .enq { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(3rem, 7vw, 7rem); align-items: start; }
  .enq__lead { display: grid; gap: 1.25rem; }
  .enq__title { font-size: clamp(2.5rem, 5.8vw, 5.25rem); font-weight: 650; font-variation-settings: "wdth" 104; line-height: 1; letter-spacing: -0.035em; text-wrap: balance; }
  .enq__dm { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.25rem; margin-top: 0.6rem; }

  .form { background: var(--warm); color: var(--ink); padding: clamp(1.4rem, 3vw, 2.5rem); border-radius: 3px; caret-color: var(--brass); }
  .form :focus-visible { outline-color: var(--brass); }
  .form__flag { padding: 0.8rem 0.95rem; margin-bottom: 1.5rem; background: var(--gold); font-size: 0.9875rem; line-height: 1.4; border-radius: 2px; }
  form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.15rem 1.25rem; }
  form[hidden] { display: none; }
  .f { display: grid; gap: 0.35rem; align-content: start; min-width: 0; }
  .f--full, .form__go { grid-column: 1 / -1; }
  label { font-weight: 620; font-size: 1rem; font-variation-settings: "wdth" 92; }
  label span { font-weight: 450; color: var(--ink-soft); }
  input, select, textarea {
    width: 100%; min-height: 3.25rem; padding: 0.7rem 0.8rem;
    border: 0; border-radius: 2px;
    background: #fffdf8; box-shadow: inset 0 0 0 1.5px rgb(28 29 31 / 0.42);
    font-size: 1.0625rem; color: var(--ink);
    transition: box-shadow 200ms ease;
  }
  textarea { resize: vertical; display: block; }
  select { appearance: none; padding-right: 2.5rem; cursor: pointer; }
  .f__select { position: relative; }
  .f__select svg { position: absolute; top: 50%; right: 0.75rem; width: 1.2rem; height: 1.2rem; margin-top: -0.6rem; fill: none; stroke: var(--ink); stroke-width: 2; pointer-events: none; }
  @media (hover: hover) { input:hover, select:hover, textarea:hover { box-shadow: inset 0 0 0 1.5px var(--ink); } }
  input:focus, select:focus, textarea:focus { box-shadow: inset 0 0 0 2px var(--ink); }
  [aria-invalid="true"] { box-shadow: inset 0 0 0 2px #a32a12; }
  .f__err { color: #8f2410; font-size: 0.9375rem; line-height: 1.3; font-weight: 560; }
  select.is-set { animation: set 900ms var(--ease); }
  @keyframes set { 0% { background: var(--gold); } }

  .done { display: grid; gap: 1rem; justify-items: start; outline: 0; }
  .done[hidden] { display: none; }
  .done__reset { border: 0; background-color: transparent; padding: 0; cursor: pointer; }

  @media (max-width: 960px) { .enq { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    form { grid-template-columns: 1fr; }
    .enq__dm .btn, .done .btn { width: 100%; }
  }
</style>

<script>
  import "../scripts/enquiry";
</script>
