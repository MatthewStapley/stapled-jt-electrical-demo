---
// The hero is the badge opened out: the sample room sits inside a huge cropped
// ring with the tapered sweep on its left, and the identity band crosses it.
// The entrance only ever animates from a finished page, using backwards fill.
import { asset, brand } from "../data/site";
const ig = '<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><path d="M16.9 7.1h.01"/>';
---
<section class="hero" aria-labelledby="hero-title" data-hero data-lights="on">
  <div class="stage">
    <div class="orb">
      <span class="orb__sweep" aria-hidden="true"></span>
      <div class="orb__room">
        <picture>
          <source media="(max-width: 860px)" srcset={asset("/renders/kitchen-tall-dusk.webp")} width="864" height="1400" />
          <img class="orb__img" src={asset("/renders/kitchen-wide-dusk.webp")} alt="" width="1600" height="1000" />
        </picture>
        <picture>
          <source media="(max-width: 860px)" srcset={asset("/renders/kitchen-tall-lit.webp")} width="864" height="1400" />
          <img class="orb__img orb__lit" src={asset("/renders/kitchen-wide-lit.webp")} alt="Sample visualisation of a kitchen at dusk, with three globe pendants over a stone island. Not a JT Electrical project." width="1600" height="1000" fetchpriority="high" />
        </picture>
        <span class="orb__shade" aria-hidden="true"></span>
      </div>
      <svg class="orb__ring" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="49.7" pathLength="1" /></svg>
    </div>
    <p class="hero__sample">Sample image, not JT Electrical's work</p>
  </div>

  <div class="copy">
    <p class="id">
      <span class="id__name">{brand.name}</span>
      <span class="id__line">Precision &amp; Quality.</span>
    </p>
    <h1 id="hero-title" class="shout h1">
      <span class="ln" style="--n:2"><span>Every</span></span>{" "}
      <span class="ln" style="--n:1"><span>detail</span></span>{" "}
      <span class="ln ln--hot" style="--n:0"><span>matters.</span></span>
    </h1>
    <p class="desc">Domestic and commercial electrical work in {brand.area}. {brand.promise}.</p>
    <div class="cta">
      <a class="btn" href={brand.instagram} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ig}></svg>
        <span>Message on Instagram</span>
      </a>
      <a class="btn btn--line" href="#services">Our services</a>
    </div>
  </div>

  <button type="button" class="lamp" role="switch" aria-checked="true" aria-label="Sample room lights" data-room-switch><span data-room-state>On</span></button>
</section>

<style>
  .hero {
    --hh: clamp(33rem, calc(100svh - var(--bar-h) - var(--header-h)), 58rem);
    --d: calc(var(--hh) * 1.36);
    --ox: max(50.5%, calc(100% - var(--d) * 0.84));
    position: relative;
    height: var(--hh);
    display: grid;
    align-items: center;
    padding-inline: var(--gutter);
    background: var(--char);
    color: var(--on-char);
    overflow: clip;
  }

  /* The ring: sized from the hero's height, cropped by the hero on three sides. */
  .stage { position: absolute; inset: 0; }
  .orb {
    position: absolute;
    top: calc((var(--hh) - var(--d)) / 2);
    left: var(--ox);
    width: var(--d);
    height: var(--d);
  }
  /* Offsetting a yellow disc behind the image leaves the badge's tapered sweep. */
  .orb__sweep { position: absolute; inset: 0; border-radius: 50%; background: var(--volt); transform: translateX(-1.9%); }
  .orb__room { position: absolute; inset: 0; border-radius: 50%; overflow: hidden; background: var(--char-deep); }
  .orb__room picture { position: absolute; inset: 0; }
  .orb__img { position: absolute; top: 0; left: calc(var(--d) * -0.74); width: auto; max-width: none; height: 100%; }
  .orb__lit { transition: opacity 800ms ease; }
  .hero[data-lights="off"] .orb__lit { opacity: 0; }
  .orb__shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(24 25 27 / 0.62) 0%, rgb(24 25 27 / 0) 34%); }
  .orb__ring { position: absolute; inset: -3.4%; width: 106.8%; height: 106.8%; max-width: none; overflow: visible; fill: none; stroke: var(--volt); stroke-width: 0.16; transform: rotate(150deg); }
  .orb__ring circle { stroke-dasharray: 1; }

  /* The switch sits on the ring, 150 degrees round. */
  .lamp {
    position: absolute;
    left: calc(var(--ox) + var(--d) * 0.03);
    top: calc((var(--hh) - var(--d)) / 2 + var(--d) * 0.775);
    z-index: 4;
    width: 4rem; height: 4rem; margin: -2rem 0 0 -2rem;
    border: 2px solid var(--volt); border-radius: 50%;
    background: var(--volt); color: var(--char);
    font-family: var(--display); font-style: italic; font-weight: 800; font-variation-settings: "wdth" 110; text-transform: uppercase; font-size: 1.05rem;
    cursor: pointer;
    transition: background-color 220ms ease, color 220ms ease, transform 200ms var(--ease);
  }
  .lamp[aria-checked="false"] { background: var(--char); color: var(--volt); }
  .lamp:active { transform: scale(0.95); }
  @media (hover: hover) { .lamp:hover { transform: scale(1.06); } }

  .hero__sample {
    position: absolute; right: 0; bottom: 0;
    padding: 0.3rem var(--gutter) 0.3rem 1.4rem;
    background: var(--char); color: var(--on-char);
    font-size: 0.8125rem; font-variation-settings: "wdth" 88;
    clip-path: polygon(0.7rem 0, 100% 0, 100% 100%, 0 100%);
  }

  /* Copy */
  .copy { position: relative; z-index: 3; display: grid; justify-items: start; gap: clamp(0.8rem, 2.3svh, 1.5rem); }
  .id {
    position: relative; z-index: 0;
    display: flex; align-items: center; gap: 1.5rem;
    width: calc(50.5vw + 1.25rem);
    margin-left: calc(var(--gutter) * -1);
    padding: 0.55rem 2rem 0.55rem var(--gutter);
    color: var(--char);
    line-height: 1;
    white-space: nowrap;
  }
  .id::before { content: ""; position: absolute; inset: 0 0 0 -3rem; z-index: -1; background: var(--volt); transform: skewX(var(--slant)); }
  .id__name { font-family: var(--display); font-style: italic; font-weight: 800; font-variation-settings: "wdth" 125; text-transform: uppercase; font-size: clamp(1.55rem, 2.75vw, 2.75rem); }
  .id__line { font-family: var(--display); font-style: italic; font-weight: 600; font-variation-settings: "wdth" 100; font-size: clamp(1rem, 1.45vw, 1.45rem); }

  .h1 { --lean: 0.34em; font-size: clamp(3.3rem, min(7.15vw, 14.2svh), 9.25rem); }
  .ln { display: block; overflow: hidden; padding: 0.04em 0.2em 0.04em calc(var(--n) * var(--lean)); margin-right: -0.2em; }
  .ln > span { display: block; }
  .ln--hot { color: var(--volt); }
  .desc { max-width: 27em; font-size: clamp(1.0625rem, 1.45vw, 1.3rem); line-height: 1.4; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-left: -0.5rem; }

  @media (max-width: 860px) {
    .hero { --d: 128vw; --stage: clamp(5.5rem, 28svh, 16rem); height: auto; display: block; padding: 0; }
    .orb__ring { stroke-width: 0.32; }
    .stage { position: relative; inset: auto; height: var(--stage); overflow: clip; }
    .orb { top: auto; bottom: calc(var(--d) * -0.09); left: auto; right: calc(var(--d) * -0.22); }
    .orb__sweep { transform: translate(-1.8%, -1.2%); }
    .orb__img { left: 0; width: 100%; height: auto; top: calc(var(--d) * -0.1); }
    .orb__shade { background: linear-gradient(0deg, rgb(24 25 27 / 0.4) 0%, rgb(24 25 27 / 0) 30%); }
    .lamp { left: var(--gutter); top: calc(var(--stage) - 3.95rem); width: 3.25rem; height: 3.25rem; margin: 0; font-size: 0.9rem; }
    .hero__sample { right: 0; bottom: 0; padding-right: var(--gutter); font-size: 0.75rem; z-index: 1; }
    .copy { padding: 0 var(--gutter) 1.5rem; gap: 0.8rem; }
    .id { display: grid; gap: 0.3rem; width: min(84%, 22rem); margin-left: calc(var(--gutter) * -1); padding: 0.55rem 1.5rem 0.55rem var(--gutter); }
    .id__name { font-size: 1.6rem; }
    .id__line { font-size: 1rem; }
    .h1 { font-size: clamp(2.8rem, 16.4vw, 6.5rem); }
    .cta { width: 100%; margin-left: 0; }
    .cta .btn:first-child { flex: 1 1 100%; }
    .cta .btn--line { flex: 1 1 100%; min-height: 3rem; }
  }
  @media (max-width: 860px) and (max-height: 700px) {
    .cta .btn--line, .lamp { display: none; }
    .hero { --stage: 3.25rem; }
    .hero__sample { font-size: 0.6875rem; padding-block: 0.15rem; }
    .id { padding-block: 0.4rem; }
    .h1 { font-size: 14.6vw; }
    .copy { gap: 0.6rem; }
    .desc { font-size: 1rem; line-height: 1.32; }
  }

  /* Essential content is in place within about 700ms. */
  @media (prefers-reduced-motion: no-preference) {
    .id { animation: band 620ms var(--ease) backwards; }
    .ln > span { animation: rise 760ms var(--ease) backwards; }
    .ln:nth-child(1) > span { animation-delay: 60ms; }
    .ln:nth-child(2) > span { animation-delay: 120ms; }
    .ln:nth-child(3) > span { animation-delay: 180ms; }
    .desc, .cta { animation: lift 620ms var(--ease) 240ms backwards; }
    .cta { animation-delay: 300ms; }
    .orb__room { animation: open 1100ms var(--ease) 80ms backwards; }
    .orb__sweep { animation: charge 900ms var(--ease) 500ms backwards; }
    .orb__ring circle { animation: ring 1200ms cubic-bezier(0.6, 0, 0.1, 1) 240ms backwards; }
    .orb__lit { animation: lights 900ms ease-out 720ms backwards; }
    .lamp { animation: pop 420ms var(--ease) 900ms backwards; }
    .hero__sample { animation: lift 500ms var(--ease) 1000ms backwards; }
  }
  @keyframes band { from { clip-path: polygon(0 0, 0 0, -8% 100%, 0 100%); } to { clip-path: polygon(0 0, 112% 0, 104% 100%, 0 100%); } }
  @keyframes rise { from { transform: translate(-0.25em, 108%); } }
  @keyframes lift { from { opacity: 0; transform: translateY(0.6rem); } }
  @keyframes open { from { clip-path: circle(30% at 42% 50%); } to { clip-path: circle(50% at 50% 50%); } }
  @keyframes charge { from { transform: translateX(0); } }
  @keyframes ring { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes lights { from { opacity: 0; } }
  @keyframes pop { from { opacity: 0; transform: scale(0.6); } }
</style>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const sw = document.querySelector<HTMLButtonElement>("[data-room-switch]");
  const state = document.querySelector<HTMLElement>("[data-room-state]");
  sw?.addEventListener("click", () => {
    const on = sw.getAttribute("aria-checked") !== "true";
    sw.setAttribute("aria-checked", String(on));
    if (state) state.textContent = on ? "On" : "Off";
    if (hero) hero.dataset.lights = on ? "on" : "off";
  });
</script>
